<idea-plugin>
    <id>com.example.sendcoderef</id>
    <name>Send Code Reference to Terminal</name>
    <vendor email="support@example.com">Example</vendor>

    <depends>com.intellij.modules.platform</depends>
    <depends>org.jetbrains.plugins.terminal</depends>

    <notificationGroup id="Send Code Reference" displayType="BALLOON"/>

    <actions>
        <action id="com.example.sendcoderef.SendCodeReferenceAction"
                class="com.example.sendcoderef.SendCodeReferenceAction"
                text="Send Code Reference to Terminal"
                description="Send the selected code reference to the active IDEA Terminal">
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
            <keyboard-shortcut keymap="Mac OS X 10.5+" first-keystroke="meta shift G"/>
            <keyboard-shortcut keymap="$default" first-keystroke="ctrl shift G"/>
        </action>
    </actions>
</idea-plugin>
