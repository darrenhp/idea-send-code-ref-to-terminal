<idea-plugin>
    <id>com.example.sendcoderef</id>
    <name>Send Code Reference to Terminal</name>
    <vendor email="support@example.com">Example</vendor>

    <depends>com.intellij.modules.platform</depends>
    <depends>org.jetbrains.plugins.terminal</depends>

    <notificationGroup id="Send Code Reference" displayType="BALLOON"/>

    <extensions defaultExtensionNs="com.intellij">
        <actionPromoter implementation="com.example.sendcoderef.ToggleTerminalEditorFocusActionPromoter"/>
    </extensions>

    <actions>
        <action id="com.example.sendcoderef.SendCodeReferenceAction"
                class="com.example.sendcoderef.SendCodeReferenceAction"
                text="Send Code Reference to Terminal"
                description="Send the selected code reference to the active IDEA Terminal">
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
        </action>

        <action id="com.example.sendcoderef.ToggleTerminalEditorFocusAction"
                class="com.example.sendcoderef.ToggleTerminalEditorFocusAction"
                text="Toggle Terminal/Editor Focus"
                description="Toggle focus between the active editor and the terminal">
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
            <add-to-group group-id="Terminal.OutputContextMenu" anchor="last"/>
            <add-to-group group-id="Terminal.PromptContextMenu" anchor="last"/>
            <add-to-group group-id="Terminal.ReworkedTerminalContextMenu" anchor="last"/>
        </action>
    </actions>
</idea-plugin>
